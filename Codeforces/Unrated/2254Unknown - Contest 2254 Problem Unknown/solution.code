#include<iostream>
#include<vector>
#include <numeric>
#include<set>
#include <algorithm>
#include <cctype>
#include <iomanip>
#include <queue>
#include <unordered_map>
#include <climits>
#include <unordered_set>
#include <ctype.h>
using namespace std;


int main() {
    int t;
    cin >> t;

    while (t--) {
        int a, b, c;
        cin >> a >> b >> c;

        int ans = 0;

        while (a != b && b != c && a != c) {

           
            if (a > b && a > c)
                a--;
            else if (b > a && b > c)
                b--;
            else
                c--;

           
            if (a < b && a < c)
                a++;
            else if (b < a && b < c)
                b++;
            else
                c++;

            ans++;
        }

        cout << ans << endl;
    }

    return 0;
}