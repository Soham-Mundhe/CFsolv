#include <iomanip>
#include <queue>
#include <unordered_map>
#include <climits>
#include <unordered_set>
#include <ctype.h>
using namespace std;

int main(){
    int n,m,a,b;cin>>n>>m>>a>>b;

    int cost1 = n * a;
    int cost2 = ((n+m-1)/m) * b;
    int cost3 = (n / m) * b + (n%m)*a;

    cout<<min({cost1,cost2,cost3});


    return 0;
}